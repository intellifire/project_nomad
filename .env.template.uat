# Project Nomad — Intellifire UAT
# Generated via: op inject -i .env.template.uat -o .env --force

# ============================================
# Image pins (managed via release manifest)
# ============================================
NOMAD_IMAGE_TAG=latest
FIRESTARR_IMAGE=ghcr.io/cwfmf/firestarr-cpp/firestarr:v0.9.5.10

# ============================================
# Deployment mode
# ============================================
NOMAD_AGENCY_ID=gnwt-uat
NODE_ENV=production

# ============================================
# FireSTARR dataset (path on the host)
# ============================================
FIRESTARR_DATASET_PATH=/srv/intellifire/firestarr_data
NOMAD_DATA_PATH=/srv/intellifire/firestarr_data
FIRESTARR_EXECUTION_MODE=docker

# ============================================
# Ports
# ============================================
NOMAD_FRONTEND_HOST_PORT=4901
NOMAD_BACKEND_HOST_PORT=4901
PORT=3001

# ============================================
# Auth — Nomad sits behind EM3 backend
# ============================================
NOMAD_AUTH_MODE=simple
VITE_AUTH_MODE=simple

# ============================================
# Frontend
# ============================================
VITE_MAPBOX_TOKEN=op://Prod RO/Mapbox/access_token
VITE_API_BASE_URL=

# ============================================
# CFS FireSTARR WMS layer auth
# ============================================
CFS_FIRESTARR_AUTHKEY=op://Prod RO/NOMAD_AGENCY_KEY_NWT/NOMAD_AGENCY_KEY_NWT

# ---------------------------------------------------------------------------
# Added for upstream v0.19.0. These four keys are new in upstream .env.example
# between v0.11.5 and v0.19.0; the removed FIRESTARR_DATASET_SOURCE was never
# referenced by these templates, so nothing needed deleting.
# ---------------------------------------------------------------------------

# Dataset index the FireSTARR installer reads to discover available vintages.
# Per-environment dataset version and url remain pinned in the platform
# release-manifest; this only tells the installer where the catalogue lives.
FIRESTARR_DATASET_INDEX=https://fgmfiles.spyd.com/datasets/nomad/index.json

# Usage log. This MUST be the CONTAINER path, not the host path:
# docker-compose.intellifire.yaml mounts ${FIRESTARR_DATASET_PATH} at /appl/data
# and overrides NOMAD_DATA_PATH to /appl/data, so the host value above does not
# apply inside the container. A path outside that mount lives on the overlay
# filesystem and is destroyed on every container recreation - silently, because
# the writes still succeed.
NOMAD_USAGE_LOG_PATH=/appl/data/usage/usage.jsonl
# 52428800 = 50 MB. Oldest events are discarded when exceeded.
NOMAD_USAGE_LOG_MAX_BYTES=52428800

# Home timezone. Must be a zone NAME - a fixed offset cannot observe DST.
# OPEN QUESTION, DELIBERATELY NOT SETTLED HERE: upstream defaults to
# America/Edmonton. America/Yellowknife is the correct zone for NWT and is used
# here for that reason, but in current tzdata it is a LINK to America/Edmonton -
# both report MST for 2026-12-15 - so it does NOT yet encode the Northwest
# Territories move to permanent UTC-06 on 2026-11-01. Until a tzdata carrying
# that rule is in the image, either name yields the same (wrong after that date)
# winter offset. Revisit before relying on this for any NWT-local time.
NOMAD_HOME_TIMEZONE=America/Yellowknife
