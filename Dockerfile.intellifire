# Intellifire Nomad Dockerfile — backend-only build.
#
# Skips the frontend build stage entirely. In our deployment, EM3 vendors
# Nomad's frontend tgz and serves it via its own bundle, so the backend
# never needs to serve static assets. backend/src/index.ts handles a
# missing frontend/dist gracefully (logs a warning, skips static serving).
#
# This file mirrors stages 2 (backend-builder) and 3 (production) from
# upstream's backend/Dockerfile. Re-sync when upstream changes those stages.

# ---- Stage 0: FireSTARR engine files ----
# Binary mode (FIRESTARR_EXECUTION_MODE=binary) runs FireSTARR as a child
# process of the backend, so Nomad needs no Docker socket. The engine version
# is fixed here; 0.9.29 is the release staging was baselined on (2026-11-08).
ARG FIRESTARR_IMAGE=ghcr.io/cwfmf/firestarr-cpp/firestarr:0.9.29
FROM ${FIRESTARR_IMAGE} AS firestarr

# ---- Stage 1: Build backend ----
FROM node:22-slim AS backend-builder

WORKDIR /app

# Install GDAL native libraries (required for gdal-async)
RUN apt-get update && apt-get install -y \
    gdal-bin \
    libgdal-dev \
    python3 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy package manifests first (maximizes layer cache for npm ci)
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/

# Install backend dependencies only
RUN --mount=type=cache,target=/root/.npm \
    npm ci --workspace=@nomad/backend

# Copy backend source
COPY backend/ ./backend/

# Build backend
RUN npm run build --workspace=@nomad/backend

# ---- Stage 2: Production ----
FROM node:22-slim AS production

# GDAL runtime libraries and Docker CLI (for spawning FireSTARR containers)
RUN apt-get update && apt-get install -y \
    gdal-bin \
    libgdal-dev \
    ca-certificates \
    curl \
    gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Preserve workspace-relative paths so backend's resolve() math still works
COPY --from=backend-builder /app/backend/dist ./backend/dist
COPY --from=backend-builder /app/node_modules ./node_modules
COPY --from=backend-builder /app/backend/package.json ./backend/

# Runtime data the backend reads from the repo rather than from node_modules.
# `vendor/wise-protos/fgmj_descriptor_set.pb` is REQUIRED at startup: the
# Prometheus importer loads it in weatherPatchOperations, and its absence is a
# hard throw, not a degraded mode — the process exits 1 and the container
# restart-loops. This image is backend-only and had never copied vendor/,
# which was harmless until upstream added that dependency after v0.11.5.
# Copied from the build context rather than the builder stage, because the
# builder only ever receives backend/.
COPY vendor/ ./vendor/

# Version. appVersion.ts resolves NOMAD_VERSION, else /app/VERSION, and THROWS
# when it has neither rather than reporting a placeholder — so a missing file
# is a startup failure, not a degraded mode. Upstream bakes it in its
# frontend-builder stage (backend/Dockerfile:211-214) from
# frontend/package.json, which is the release source of truth; the root and
# backend package.json files are never bumped. This image has no frontend
# stage, so the manifest comes from the build context, as vendor/ does above.
# `cat` is deliberate: it fails the BUILD if the file did not get written,
# which is the only place this class of fault is visible.
COPY frontend/package.json /tmp/frontend-package.json
RUN node -p "require('/tmp/frontend-package.json').version" > /app/VERSION \
    && rm /tmp/frontend-package.json \
    && cat /app/VERSION

# FireSTARR binary plus the files it reads beside it (settings.ini, fuel.lut,
# proj.db). RASTER_ROOT points at the dataset mount, which the docker-mode
# compose wrapper used to set with sed at every run.
COPY --from=firestarr /appl/firestarr /appl/firestarr
RUN sed -i 's|RASTER_ROOT.*|RASTER_ROOT = /appl/data/generated/grid/100m|' /appl/firestarr/settings.ini \
    && grep -q '^RASTER_ROOT = /appl/data/generated/grid/100m' /appl/firestarr/settings.ini

# NOTE: No frontend/dist copy. backend/src/index.ts existsSync() check
# will skip static-file serving and log a benign startup warning.

EXPOSE 3001
WORKDIR /app/backend
CMD ["node", "dist/index.js"]
